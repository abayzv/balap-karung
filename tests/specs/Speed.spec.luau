return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
	local Speed = require(ReplicatedStorage.Shared.Speed)

	describe("Speed", function()
		it("clamps progress to the On Fire requirement", function()
			expect(Speed.clampProgress(-1)).to.equal(0)
			expect(Speed.clampProgress(100)).to.equal(GameConfig.speed.onFireRequiredHits)
		end)

		it("counts Good and Perfect as no-miss progress", function()
			local progress = Speed.applyVerdict(3, "Good")
			expect(progress).to.equal(4)
			progress = Speed.applyVerdict(progress, "Perfect")
			expect(progress).to.equal(5)
		end)

		it("enters the faster tempo after three hits", function()
			expect(Speed.stageForProgress(2)).to.equal(1)
			expect(Speed.stageForProgress(3)).to.equal(2)
		end)

		it("triggers On Fire after five hits", function()
			local progress, stage, onFire = Speed.applyVerdict(4, "Perfect")
			expect(progress).to.equal(5)
			expect(stage).to.equal(3)
			expect(onFire).to.equal(true)
		end)

		it("resets all progress and On Fire on Miss", function()
			local progress, stage, onFire = Speed.applyVerdict(5, "Miss")
			expect(progress).to.equal(0)
			expect(stage).to.equal(1)
			expect(onFire).to.equal(false)
		end)

		it("punishes Early input like a Miss", function()
			local progress, stage, onFire = Speed.applyVerdict(5, "Early")
			expect(progress).to.equal(0)
			expect(stage).to.equal(1)
			expect(onFire).to.equal(false)
		end)

		it("uses only Normal and On Fire movement speeds", function()
			expect(Speed.valueForOnFire(false)).to.equal(GameConfig.speed.normalValue)
			expect(Speed.valueForOnFire(true)).to.equal(GameConfig.speed.onFireValue)
		end)
	end)
end
